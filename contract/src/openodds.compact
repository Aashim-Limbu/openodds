// OpenOdds — E2 spike: claim circuit de-risk.
// Single market, no Zswap yet (that's spike E1). Goal: prove the four risky pieces
// compile and verify on toolchain 0.31.1 / language 0.23:
//   1. commitment + nullifier + HistoricMerkleTree membership (anonymous claim)
//   2. witness-quotient division  q*W <= k*T < (q+1)*W  (no division in Compact)
//   3. WIN / PUSH / REFUND branching derived in-circuit from one posted score fact
//   4. half-point line math with no subtraction (runtime underflow) and no signed ints
// SPDX-License-Identifier: Apache-2.0

pragma language_version 0.23;

import CompactStandardLibrary;

// ---------- market status ----------
export enum MarketStatus {
  OPEN,
  RESOLVED,
  VOID
}

// ---------- market types ----------
// 0 = moneyline (outcome 0 = home, 1 = away; equal scores => PUSH in spike)
// 1 = spread    (outcome 0 = favorite covers, 1 = underdog covers)
// 2 = total     (outcome 0 = over, 1 = under)

// ---------- sealed config ----------
export sealed ledger oracleKeyHash: Bytes<32>;
export sealed ledger marketType: Uint<8>;
export sealed ledger halfLine: Uint<16>; // line in half-points (e.g. -6.5 => 13)
export sealed ledger favIsHome: Boolean; // spread only: which side lays the line

// ---------- public pools (odds are public by design) ----------
export ledger poolA: Uint<64>; // tickets on outcome 0
export ledger poolB: Uint<64>; // tickets on outcome 1

// ---------- resolution fact ----------
export ledger status: MarketStatus;
export ledger homeScore2: Uint<16>; // final score in half-points (score * 2)
export ledger awayScore2: Uint<16>;

// ---------- privacy machinery ----------
export ledger commitments: HistoricMerkleTree<10, Bytes<32>>;
export ledger nullifiers: Set<Bytes<32>>;

constructor(
  initOracleKeyHash: Bytes<32>,
  initMarketType: Uint<8>,
  initHalfLine: Uint<16>,
  initFavIsHome: Boolean
) {
  // Market parameters are public config.
  oracleKeyHash = disclose(initOracleKeyHash);
  marketType = disclose(initMarketType);
  halfLine = disclose(initHalfLine);
  favIsHome = disclose(initFavIsHome);
  status = MarketStatus.OPEN;
}

// ---------- witnesses (private inputs, provided by local TS) ----------
witness betSecret(): Bytes<32>;
witness betOutcome(): Uint<8>;
witness betTickets(): Uint<32>;
witness betPath(commitment: Bytes<32>): MerkleTreePath<10, Bytes<32>>;
witness payoutQuotient(): Uint<64>;
witness oracleSecretKey(): Bytes<32>;

// ---------- helpers (exported => callable from TS as pureCircuits) ----------
export circuit commitmentFor(sk: Bytes<32>, outcome: Uint<8>, tickets: Uint<32>): Bytes<32> {
  return persistentCommit<Vector<2, Field>>(
    [outcome as Field, tickets as Field],
    sk
  );
}

export circuit nullifierFor(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "openodds:nul:"), sk]);
}

export circuit oracleKhOf(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "openodds:oracle:"), sk]);
}

// Resolution as a pure function of the posted fact. Returns 0 = outcome0 won,
// 1 = outcome1 won, 2 = push. All comparisons, no subtraction.
circuit resolveOutcome(): Uint<8> {
  // moneyline
  if (marketType == 0) {
    if (homeScore2 > awayScore2) { return 0; }
    if (awayScore2 > homeScore2) { return 1; }
    return 2; // draw => push (spike simplification; 3-way market handles draws)
  }
  // spread: favorite covers iff favScore2 > dogScore2 + halfLine
  if (marketType == 1) {
    const favScore2 = favIsHome ? homeScore2 : awayScore2;
    const dogScore2 = favIsHome ? awayScore2 : homeScore2;
    const dogPlusLine = dogScore2 + halfLine;
    if (favScore2 > dogPlusLine) { return 0; }
    if (dogPlusLine > favScore2) { return 1; }
    return 2; // exact landing: only reachable on even half-lines
  }
  // total: over iff home2 + away2 > halfLine
  const sum2 = homeScore2 + awayScore2;
  if (sum2 > halfLine) { return 0; }
  if (halfLine > sum2) { return 1; }
  return 2;
}

// ---------- circuits ----------

export circuit placeBet(outcome: Uint<8>, tickets: Uint<32>): [] {
  assert(status == MarketStatus.OPEN, "market closed");
  assert(outcome <= 1, "bad outcome");
  assert(tickets >= 1, "zero tickets");
  // Anonymous position: only the commitment goes in the tree.
  const c = commitmentFor(betSecret(), outcome, tickets);
  commitments.insert(disclose(c));
  // Public pool delta: odds are public by design (this is the product, not a leak).
  // disclose(): side and size are public; WHO is betting never appears anywhere.
  if (disclose(outcome == 0)) {
    poolA = (poolA + disclose(tickets)) as Uint<64>;
  } else {
    poolB = (poolB + disclose(tickets)) as Uint<64>;
  }
}

export circuit postScore(h2: Uint<16>, a2: Uint<16>): [] {
  assert(status == MarketStatus.OPEN, "already resolved");
  const kh = persistentHash<Vector<2, Bytes<32>>>(
    [pad(32, "openodds:oracle:"), oracleSecretKey()]
  );
  assert(kh == oracleKeyHash, "not the oracle");
  homeScore2 = disclose(h2);
  awayScore2 = disclose(a2);
  status = MarketStatus.RESOLVED;
}

export circuit voidMarket(): [] {
  assert(status == MarketStatus.OPEN, "already resolved");
  const kh = persistentHash<Vector<2, Bytes<32>>>(
    [pad(32, "openodds:oracle:"), oracleSecretKey()]
  );
  assert(kh == oracleKeyHash, "not the oracle");
  status = MarketStatus.VOID;
}

// Returns payout in ticket units (money wiring is spike E1's job).
// WIN: pro-rata share of the whole pot: q where q*W <= k*T < (q+1)*W.
// PUSH / VOID: stake back (k).
export circuit claim(): Uint<64> {
  assert(status != MarketStatus.OPEN, "market not resolved");

  const sk = betSecret();
  const outcome = betOutcome();
  const tickets = betTickets();
  assert(outcome <= 1, "bad witness outcome");
  assert(tickets >= 1, "bad witness tickets");

  // membership: my commitment is in the tree
  const c = commitmentFor(sk, outcome, tickets);
  const path = betPath(c);
  assert(path.leaf == c, "path is not for this commitment");
  // disclose(): the candidate root is public history — it reveals nothing about
  // WHICH leaf the path proves membership of.
  assert(
    commitments.checkRoot(disclose(merkleTreePathRoot<10, Bytes<32>>(path))),
    "commitment not in tree"
  );

  // spend-once
  const nul = nullifierFor(sk);
  assert(!nullifiers.member(disclose(nul)), "already claimed");
  nullifiers.insert(disclose(nul));

  // VOID => refund stake
  if (status == MarketStatus.VOID) {
    return disclose(tickets as Uint<64>);
  }

  const result = resolveOutcome();

  // PUSH => refund stake
  if (result == 2) {
    return disclose(tickets as Uint<64>);
  }

  // lost => nothing (nullifier still burned above: no re-try with a different story)
  // disclose: claiming inherently reveals win/loss — the payout amount is public.
  // (Documented leak: bet<->claim linkable when your ticket count is unique.)
  const won = disclose(
    (result == 0 && outcome == 0) || (result == 1 && outcome == 1)
  );
  if (!won) {
    return 0;
  }

  // WIN => witness-quotient division over the full pot
  const totalT = (poolA + poolB) as Uint<64>;
  const winW = result == 0 ? poolA : poolB;
  assert(winW >= 1, "empty winning pool");
  const k = tickets as Uint<64>;
  const q = payoutQuotient();
  // q*W <= k*T < (q+1)*W   (products fit Uint<128>)
  const kT = k * totalT;
  const qW = q * winW;
  assert(qW <= kT, "quotient too big");
  assert(kT < qW + winW, "quotient too small");
  return disclose(q);
}
