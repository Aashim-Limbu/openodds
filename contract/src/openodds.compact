// OpenOdds — private parimutuel betting on Midnight.
//
// Public: odds (pool sizes), lines, oracle facts, payouts.
// Private: WHO bet. Stakes arrive as shielded coins (no payer field); positions
// are commitments in an anonymity set; claims prove membership and burn a
// nullifier, paying a fresh shielded output.
//
// Resolution: the oracle posts ONE fact per event — (homeScore2, awayScore2) in
// half-points. Every market on that event (moneyline, any spread, any total)
// derives its own outcome from that single fact, in-circuit, at claim time.
// One oracle transaction settles a whole game's slate.
//
// SPDX-License-Identifier: Apache-2.0

pragma language_version 0.23;

import CompactStandardLibrary;

// ---------- market types ----------
// 0 = moneyline  (outcome 0 = home, 1 = away; equal scores => PUSH)
// 1 = spread     (outcome 0 = favorite covers, 1 = underdog covers)
// 2 = total      (outcome 0 = over, 1 = under)

// ---------- event status ----------
export enum EventStatus {
  PENDING,
  FINAL,
  VOID
}

export struct MarketParams {
  eventId: Bytes<32>,
  marketType: Uint<8>,
  // line in half-points: -6.5 => 13, O/U 41.5 => 83.
  // Odd values can never push; even values push on an exact landing.
  halfLine: Uint<16>,
  favIsHome: Boolean,
  exists: Boolean
}

export struct EventFact {
  homeScore2: Uint<16>,
  awayScore2: Uint<16>,
  status: EventStatus,
  exists: Boolean
}

// ---------- config ----------
export sealed ledger oracleKeyHash: Bytes<32>;

// ---------- markets and events ----------
export ledger markets: Map<Bytes<32>, MarketParams>;
export ledger events: Map<Bytes<32>, EventFact>;
// poolKey(marketId, outcome) -> ticket count. Composite key keeps this a single
// flat Map: no nested-map default initialisation, one lookup per access.
export ledger pools: Map<Bytes<32>, Uint<64>>;

// ---------- privacy machinery ----------
// One anonymity set across every market: a bet in a quiet market still hides
// in the crowd of the busy one.
export ledger commitments: HistoricMerkleTree<12, Bytes<32>>;
export ledger nullifiers: Set<Bytes<32>>;

// ---------- treasury ----------
// Single merged escrow coin across all markets (money is fungible). Merge on
// every bet so any claim can be paid from one coin.
export ledger treasury: QualifiedShieldedCoinInfo;
export ledger treasuryFunded: Boolean;

constructor(initOracleKeyHash: Bytes<32>) {
  oracleKeyHash = disclose(initOracleKeyHash);
}

// ---------- constants ----------
// ponytail: one global ticket price; per-market pricing when a market needs it
export circuit ticketPrice(): Uint<128> {
  return 100;
}

// ---------- witnesses (private, supplied by the local machine) ----------
witness betSecret(): Bytes<32>;
witness betMarketId(): Bytes<32>;
witness betOutcome(): Uint<8>;
witness betTickets(): Uint<32>;
witness betPath(commitment: Bytes<32>): MerkleTreePath<12, Bytes<32>>;
witness payoutQuotient(): Uint<64>;
witness payoutRecipient(): ZswapCoinPublicKey;
witness oracleSecretKey(): Bytes<32>;

// ---------- pure helpers (exported => usable from TS) ----------
export circuit commitmentFor(
  sk: Bytes<32>,
  marketId: Bytes<32>,
  outcome: Uint<8>,
  tickets: Uint<32>
): Bytes<32> {
  return persistentCommit<Vector<3, Field>>(
    [marketId as Field, outcome as Field, tickets as Field],
    sk
  );
}

export circuit nullifierFor(sk: Bytes<32>, marketId: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>(
    [pad(32, "openodds:nul:"), marketId, sk]
  );
}

export circuit oracleKhOf(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "openodds:oracle:"), sk]);
}

export circuit poolKey(marketId: Bytes<32>, outcome: Uint<8>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>(
    [pad(32, "openodds:pool:"), marketId, outcome as Field as Bytes<32>]
  );
}

// ---------- internal helpers ----------
circuit assertOracle(): [] {
  const kh = persistentHash<Vector<2, Bytes<32>>>(
    [pad(32, "openodds:oracle:"), oracleSecretKey()]
  );
  assert(kh == oracleKeyHash, "not the oracle");
}

circuit poolOf(marketId: Bytes<32>, outcome: Uint<8>): Uint<64> {
  // disclose: pool sizes ARE the odds — public by design. Reading one reveals
  // which market/side is being touched, never who is touching it.
  const k = disclose(poolKey(marketId, outcome));
  if (!pools.member(k)) { return 0; }
  return pools.lookup(k);
}

// Outcome of a market as a pure function of its event's posted fact.
// Returns 0 = outcome0 won, 1 = outcome1 won, 2 = push.
// Comparisons only — no subtraction, so no Uint underflow.
circuit outcomeOf(m: MarketParams, f: EventFact): Uint<8> {
  if (m.marketType == 0) {
    if (f.homeScore2 > f.awayScore2) { return 0; }
    if (f.awayScore2 > f.homeScore2) { return 1; }
    return 2; // draw: moneyline pushes (3-way markets model the draw as its own market)
  }
  if (m.marketType == 1) {
    const favScore2 = m.favIsHome ? f.homeScore2 : f.awayScore2;
    const dogScore2 = m.favIsHome ? f.awayScore2 : f.homeScore2;
    const dogPlusLine = dogScore2 + m.halfLine;
    if (favScore2 > dogPlusLine) { return 0; }
    if (dogPlusLine > favScore2) { return 1; }
    return 2; // exact landing — only reachable on an even half-line
  }
  const sum2 = f.homeScore2 + f.awayScore2;
  if (sum2 > m.halfLine) { return 0; }
  if (m.halfLine > sum2) { return 1; }
  return 2;
}

// ---------- oracle / creator circuits ----------

export circuit createEvent(eventId: Bytes<32>): [] {
  assertOracle();
  assert(!events.member(disclose(eventId)), "event exists");
  events.insert(
    disclose(eventId),
    EventFact { homeScore2: 0, awayScore2: 0, status: EventStatus.PENDING, exists: true }
  );
}

export circuit createMarket(
  marketId: Bytes<32>,
  eventId: Bytes<32>,
  marketType: Uint<8>,
  halfLine: Uint<16>,
  favIsHome: Boolean
): [] {
  assertOracle();
  assert(!markets.member(disclose(marketId)), "market exists");
  assert(events.member(disclose(eventId)), "no such event");
  assert(marketType <= 2, "bad market type");
  markets.insert(
    disclose(marketId),
    MarketParams {
      eventId: disclose(eventId),
      marketType: disclose(marketType),
      halfLine: disclose(halfLine),
      favIsHome: disclose(favIsHome),
      exists: true
    }
  );
}

// One fact settles every market on the event.
export circuit postScore(eventId: Bytes<32>, h2: Uint<16>, a2: Uint<16>): [] {
  assertOracle();
  assert(events.member(disclose(eventId)), "no such event");
  const f = events.lookup(disclose(eventId));
  assert(f.status == EventStatus.PENDING, "already resolved");
  events.insert(
    disclose(eventId),
    EventFact {
      homeScore2: disclose(h2),
      awayScore2: disclose(a2),
      status: EventStatus.FINAL,
      exists: true
    }
  );
}

// Postponed/abandoned: every market on the event refunds.
export circuit voidEvent(eventId: Bytes<32>): [] {
  assertOracle();
  assert(events.member(disclose(eventId)), "no such event");
  const f = events.lookup(disclose(eventId));
  assert(f.status == EventStatus.PENDING, "already resolved");
  events.insert(
    disclose(eventId),
    EventFact {
      homeScore2: f.homeScore2,
      awayScore2: f.awayScore2,
      status: EventStatus.VOID,
      exists: true
    }
  );
}

// ---------- bettor circuits ----------

export circuit placeBet(
  coin: ShieldedCoinInfo,
  marketId: Bytes<32>,
  outcome: Uint<8>,
  tickets: Uint<32>
): [] {
  assert(markets.member(disclose(marketId)), "no such market");
  const m = markets.lookup(disclose(marketId));
  const f = events.lookup(m.eventId);
  assert(f.status == EventStatus.PENDING, "event already resolved");
  assert(outcome <= 1, "bad outcome");
  assert(tickets >= 1, "zero tickets");

  // Escrow the stake. A shielded coin carries no payer, so nothing on the
  // ledger says who funded this.
  assert(coin.color == nativeToken(), "wrong token");
  assert(coin.value == (tickets * ticketPrice()) as Uint<128>, "stake != tickets * price");
  receiveShielded(disclose(coin));
  if (treasuryFunded) {
    treasury.writeCoin(
      mergeCoinImmediate(treasury, disclose(coin)),
      right<ZswapCoinPublicKey, ContractAddress>(kernel.self())
    );
  } else {
    treasury.writeCoin(
      disclose(coin),
      right<ZswapCoinPublicKey, ContractAddress>(kernel.self())
    );
    treasuryFunded = true;
  }

  // The position: a commitment bound to this market. Identity never appears.
  const c = commitmentFor(betSecret(), marketId, outcome, tickets);
  commitments.insert(disclose(c));

  // Odds move in public. Side and size are the product; who is not.
  const k = poolKey(marketId, outcome);
  const prev = poolOf(marketId, outcome);
  pools.insert(disclose(k), disclose((prev + tickets) as Uint<64>));
}

// Payout in ticket units. WIN: pro-rata share of the whole pot.
// PUSH / VOID: stake back. LOSS: nothing (nullifier still burns).
export circuit claim(): Uint<64> {
  const sk = betSecret();
  const marketId = betMarketId();
  const outcome = betOutcome();
  const tickets = betTickets();
  assert(outcome <= 1, "bad witness outcome");
  assert(tickets >= 1, "bad witness tickets");
  assert(markets.member(disclose(marketId)), "no such market");

  const m = markets.lookup(disclose(marketId));
  const f = events.lookup(m.eventId);
  assert(f.status != EventStatus.PENDING, "event not resolved");

  // Membership: this position was really placed.
  const c = commitmentFor(sk, marketId, outcome, tickets);
  const path = betPath(c);
  assert(path.leaf == c, "path is not for this commitment");
  // The candidate root is public history; it says nothing about which leaf.
  assert(
    commitments.checkRoot(disclose(merkleTreePathRoot<12, Bytes<32>>(path))),
    "commitment not in tree"
  );

  // Spend once. Nullifier is market-scoped so one secret can bet many markets.
  const nul = nullifierFor(sk, marketId);
  assert(!nullifiers.member(disclose(nul)), "already claimed");
  nullifiers.insert(disclose(nul));

  // Claiming reveals win/loss and amount by construction — the payout is a
  // public treasury delta. (Known leak: a unique ticket count links bet<->claim.)
  const payoutTickets = disclose(claimableTickets(m, f, marketId, outcome, tickets));

  if (payoutTickets > 0) {
    assert(treasuryFunded, "treasury empty");
    const amount = (payoutTickets * ticketPrice()) as Uint<128>;
    assert(treasury.value >= amount, "treasury too small");
    const sendRes = sendShielded(
      treasury,
      left<ZswapCoinPublicKey, ContractAddress>(disclose(payoutRecipient())),
      amount
    );
    if (sendRes.change.is_some) {
      treasury.writeCoin(
        sendRes.change.value,
        right<ZswapCoinPublicKey, ContractAddress>(kernel.self())
      );
    } else {
      treasuryFunded = false;
    }
  }
  return payoutTickets;
}

circuit claimableTickets(
  m: MarketParams,
  f: EventFact,
  marketId: Bytes<32>,
  outcome: Uint<8>,
  tickets: Uint<32>
): Uint<64> {
  // Event voided => stake back.
  if (f.status == EventStatus.VOID) {
    return tickets as Uint<64>;
  }

  const result = outcomeOf(m, f);

  // Push => stake back.
  if (result == 2) {
    return tickets as Uint<64>;
  }

  const won = disclose((result == 0 && outcome == 0) || (result == 1 && outcome == 1));
  if (!won) {
    return 0;
  }

  // Pro-rata over the whole pot. Compact has no division, so the prover
  // supplies the quotient and the circuit checks it is the exact floor:
  //   q*W <= k*T < (q+1)*W
  const poolA = poolOf(marketId, 0);
  const poolB = poolOf(marketId, 1);
  const totalT = (poolA + poolB) as Uint<64>;
  const winW = result == 0 ? poolA : poolB;
  assert(winW >= 1, "empty winning pool");
  const k = tickets as Uint<64>;
  const q = payoutQuotient();
  const kT = k * totalT;
  const qW = q * winW;
  assert(qW <= kT, "quotient too big");
  assert(kT < qW + winW, "quotient too small");
  return q;
}
